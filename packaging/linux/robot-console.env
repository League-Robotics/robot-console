# Robot Console firmware release sources (installed as
# /etc/robot-console/robot-console.env; a dpkg conffile, so local edits
# survive package upgrades).
#
# Format: KEY=https://github.com/<owner>/<repo>:<release tag or "latest">
# The Flash buttons offer the release build from these repositories.
# Loaded into the robot-console user service's environment when the service
# starts; apply edits with `systemctl --user restart robot-console` (or log
# out and back in). A per-user ~/.config/robot-console/robot-console.env in
# the same format overrides these values for one user.
#
# Public values only. Never put secrets (such as WiFi credentials) here:
# this file is world-readable.

ROBOT_CONSOLE_RELAY_FIRMWARE=https://github.com/League-Robotics/microbit-radio-relay:latest
ROBOT_CONSOLE_ROBOT_FIRMWARE=https://github.com/League-Robotics/nezha-robot-template:latest
