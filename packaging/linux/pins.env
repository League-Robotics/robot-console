# Pinned build inputs for the Linux .deb (sourced by scripts/package-linux.sh
# and packaging/linux/test-install.sh). Change a version only together with
# its checksum; both scripts refuse to run with a mismatching download.

# Node.js 22 LTS ("Jod"), linux-x64 tarball from nodejs.org.
# Checksum as published in https://nodejs.org/dist/v22.23.2/SHASUMS256.txt
NODE_VERSION=22.23.2
NODE_TARBALL=node-v22.23.2-linux-x64.tar.xz
NODE_SHA256=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307

# nfpm (goreleaser) linux x86_64 release binary.
# Checksum as published in the release's checksums.txt
NFPM_VERSION=2.47.0
NFPM_TARBALL=nfpm_2.47.0_Linux_x86_64.tar.gz
NFPM_SHA256=0660ca602b2d2d2ae4781a06c692b3eeb9d437ffea05b831d76e41f4a3188783

# Build and test base image: ubuntu:24.04, pinned by manifest-list digest.
BASE_IMAGE=ubuntu:24.04@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254
